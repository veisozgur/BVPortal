@page "/yeni-teklif"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using BV.Web.Services
@inject QuoteApiClient QuoteApi
@inject ExcelQuoteImporter ExcelImporter
@inject CatalogSelection CatalogSelection
@inject SchoolSupplySetCatalogApiClient SchoolSets
@inject AuthSession Session
@inject NavigationManager Navigation

<PageTitle>Yeni Teklif | BV Portal</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">Müşteri Portalı</span>
        <h1>Yeni teklif talebi</h1>
        <p>Okul veya ofis ihtiyaçlarınızı kalem kalem ekleyin ya da Excel dosyasından aktarın.</p>
    </div>
</div>

@if (!Session.IsAuthenticated)
{
    <section class="panel empty-state">
        <h2>Oturum gerekli</h2>
        <p>Teklif oluşturmak için önce giriş yapmalısınız.</p>
        <a class="button primary" href="/giris">Giriş Yap</a>
    </section>
}
else
{
    <div class="quote-builder">
        <section class="panel">
            <EditForm Model="form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="type-selector">
                    <button type="button" class="type-card @(form.Type == 1 ? "selected" : null)" @onclick="() => form.Type = 1">
                        <strong>Okul Teklifi</strong>
                        <span>Kırtasiye, sınıf ve eğitim ihtiyaçları</span>
                    </button>
                    <button type="button" class="type-card @(form.Type == 2 ? "selected" : null)" @onclick="() => form.Type = 2">
                        <strong>Ofis Teklifi</strong>
                        <span>Ofis sarf, teknoloji ve iş yeri ihtiyaçları</span>
                    </button>
                </div>

                @if (form.Type == 1)
                {
                    <section class="panel">
                        <div class="panel-heading compact">
                            <div>
                                <h2>Okul setinden aktar</h2>
                                <p>Okul ve sınıf seçerek tanımlı kırtasiye setini teklif kalemlerine ekleyin.</p>
                            </div>
                        </div>
                        <div class="form-grid">
                            <label>Okul
                                <select class="input" value="@selectedSchoolId" @onchange="SchoolChangedAsync">
                                    <option value="">Okul seçin</option>
                                    @foreach (var school in schools)
                                    {
                                        <option value="@school.Id">@school.Name</option>
                                    }
                                </select>
                            </label>
                            <label>Sınıf / Kademe
                                <select class="input" value="@selectedGradeId" @onchange="GradeChangedAsync" disabled="@(selectedSchoolId == Guid.Empty)">
                                    <option value="">Sınıf seçin</option>
                                    @foreach (var grade in grades)
                                    {
                                        <option value="@grade.Id">@grade.Name</option>
                                    }
                                </select>
                            </label>
                            <label>Okul Seti
                                <select class="input" @bind="selectedSetId" disabled="@(selectedGradeId == Guid.Empty)">
                                    <option value="">Set seçin</option>
                                    @foreach (var set in availableSets)
                                    {
                                        <option value="@set.Id">@set.Name (@set.AcademicYear-@(set.AcademicYear + 1)) · @set.ItemCount ürün</option>
                                    }
                                </select>
                            </label>
                        </div>
                        <button type="button" class="button" @onclick="ImportSchoolSetAsync" disabled="@(selectedSetId == Guid.Empty || importingSet)">
                            @(importingSet ? "Set aktarılıyor..." : "Seti Teklife Aktar")
                        </button>
                        @if (!string.IsNullOrWhiteSpace(schoolSetMessage))
                        {
                            <div class="form-message @(schoolSetSuccess ? "success-message" : "error-message")">@schoolSetMessage</div>
                        }
                    </section>
                }

                <div class="form-grid single">
                    <label>Teklif başlığı
                        <InputText class="input" @bind-Value="form.Title" placeholder="Örn. 2026-2027 okul kırtasiye ihtiyaçları" />
                    </label>
                    <label>Açıklama
                        <InputTextArea class="input" @bind-Value="form.Description" placeholder="Teslimat, marka veya ürün özellikleri gibi ek bilgiler" />
                    </label>
                </div>

                @if (!string.IsNullOrWhiteSpace(catalogMessage))
                {
                    <div class="form-message success-message">@catalogMessage</div>
                }

                <div class="panel excel-import-panel">
                    <div class="panel-heading compact">
                        <div>
                            <h2>Excel'den ürün aktar</h2>
                            <p>Başlık satırında Ürün ve Miktar zorunludur. Birim ve Açıklama isteğe bağlıdır.</p>
                        </div>
                    </div>
                    <InputFile OnChange="ImportExcelAsync" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" disabled="@importing" />
                    <small>Maksimum dosya boyutu: 5 MB. İlk çalışma sayfası okunur.</small>
                    @if (!string.IsNullOrWhiteSpace(importMessage))
                    {
                        <div class="form-message @(importSuccess ? "success-message" : "error-message")">@importMessage</div>
                    }
                </div>

                <div class="panel-heading compact">
                    <div>
                        <h2>Ürün kalemleri</h2>
                        <p>Her ürün için miktar ve birim girin.</p>
                    </div>
                    <div class="form-row">
                        <a class="button ghost" href="/katalog">Katalogdan Ekle</a>
                        <button type="button" class="button ghost" @onclick="AddItem">+ Ürün Ekle</button>
                    </div>
                </div>

                <div class="quote-items">
                    @for (var index = 0; index < form.Items.Count; index++)
                    {
                        var item = form.Items[index];
                        var currentIndex = index;
                        <div class="quote-item">
                            <label>Ürün adı
                                <InputText class="input" @bind-Value="item.ProductName" placeholder="Ürün adı" />
                            </label>
                            <label>Miktar
                                <InputNumber class="input" @bind-Value="item.Quantity" />
                            </label>
                            <label>Birim
                                <InputText class="input" @bind-Value="item.Unit" />
                            </label>
                            <label>Açıklama
                                <InputText class="input" @bind-Value="item.Description" placeholder="Marka, renk, ölçü..." />
                            </label>
                            <button type="button" class="remove-button" title="Kalemi sil" @onclick="() => RemoveItem(currentIndex)">×</button>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="form-message @(success ? "success-message" : "error-message")">@message</div>
                }

                <div class="form-actions">
                    <label class="check-label"><InputCheckbox @bind-Value="form.Submit" /> Hemen gönder</label>
                    <button class="button primary" type="submit" disabled="@(saving || importing || importingSet)">@(saving ? "Kaydediliyor..." : form.Submit ? "Teklifi Gönder" : "Taslak Kaydet")</button>
                </div>
            </EditForm>
        </section>

        <aside class="panel quote-summary">
            <span class="eyebrow">Sepet Özeti</span>
            <h2>@form.Items.Count ürün kalemi</h2>
            <p>Toplam miktar: <strong>@form.Items.Sum(x => x.Quantity)</strong></p>
            <hr />
            @foreach (var item in form.Items.Where(x => !string.IsNullOrWhiteSpace(x.ProductName)))
            {
                <div class="summary-line">
                    <span>@item.ProductName</span>
                    <strong>@item.Quantity @item.Unit</strong>
                </div>
            }
        </aside>
    </div>
}

@code {
    private readonly QuoteFormModel form = new();
    private IReadOnlyList<SchoolOptionModel> schools = [];
    private IReadOnlyList<SchoolGradeOptionModel> grades = [];
    private IReadOnlyList<SchoolSupplySetOptionModel> availableSets = [];
    private Guid selectedSchoolId;
    private Guid selectedGradeId;
    private Guid selectedSetId;
    private bool saving;
    private bool importing;
    private bool importingSet;
    private bool success;
    private bool importSuccess;
    private bool schoolSetSuccess;
    private string? message;
    private string? importMessage;
    private string? catalogMessage;
    private string? schoolSetMessage;

    protected override async Task OnInitializedAsync()
    {
        schools = await SchoolSets.SchoolsAsync();

        if (CatalogSelection.Count == 0)
        {
            AddItem();
            return;
        }

        foreach (var selected in CatalogSelection.Items)
        {
            form.Items.Add(new CreateQuoteItemModel
            {
                ProductName = selected.ProductName,
                Quantity = selected.Quantity,
                Unit = selected.Unit,
                Description = selected.Description
            });
        }

        catalogMessage = $"Katalogdan {CatalogSelection.Count} ürün teklif formuna aktarıldı.";
        CatalogSelection.Clear();
    }

    private async Task SchoolChangedAsync(ChangeEventArgs eventArgs)
    {
        selectedSchoolId = Guid.TryParse(eventArgs.Value?.ToString(), out var id) ? id : Guid.Empty;
        selectedGradeId = Guid.Empty;
        selectedSetId = Guid.Empty;
        availableSets = [];
        grades = selectedSchoolId == Guid.Empty ? [] : await SchoolSets.GradesAsync(selectedSchoolId);
    }

    private async Task GradeChangedAsync(ChangeEventArgs eventArgs)
    {
        selectedGradeId = Guid.TryParse(eventArgs.Value?.ToString(), out var id) ? id : Guid.Empty;
        selectedSetId = Guid.Empty;
        availableSets = selectedGradeId == Guid.Empty ? [] : await SchoolSets.SetsAsync(selectedSchoolId, selectedGradeId);
    }

    private async Task ImportSchoolSetAsync()
    {
        importingSet = true;
        schoolSetMessage = null;
        schoolSetSuccess = false;

        var set = await SchoolSets.GetAsync(selectedSetId);
        importingSet = false;
        if (set is null)
        {
            schoolSetMessage = "Okul seti yüklenemedi.";
            return;
        }

        if (form.Items.Count == 1 && string.IsNullOrWhiteSpace(form.Items[0].ProductName))
            form.Items.Clear();

        foreach (var item in set.Items)
        {
            form.Items.Add(new CreateQuoteItemModel
            {
                ProductName = item.ProductName,
                Quantity = item.Quantity,
                Unit = item.Unit,
                Description = item.Description
            });
        }

        var schoolName = schools.FirstOrDefault(x => x.Id == selectedSchoolId)?.Name;
        var gradeName = grades.FirstOrDefault(x => x.Id == selectedGradeId)?.Name;
        form.Title = $"{set.AcademicYear}-{set.AcademicYear + 1} {schoolName} {gradeName} kırtasiye seti";
        schoolSetSuccess = true;
        schoolSetMessage = $"{set.Items.Count} ürün okul setinden teklif formuna aktarıldı.";
    }

    private void AddItem() => form.Items.Add(new CreateQuoteItemModel());

    private void RemoveItem(int index)
    {
        if (form.Items.Count == 1)
            return;
        form.Items.RemoveAt(index);
    }

    private async Task ImportExcelAsync(InputFileChangeEventArgs eventArgs)
    {
        importing = true;
        importMessage = null;
        importSuccess = false;

        var result = await ExcelImporter.ImportAsync(eventArgs.File);
        importing = false;
        importSuccess = result.Success;
        importMessage = result.Message;

        if (!result.Success)
            return;

        if (form.Items.Count == 1 && string.IsNullOrWhiteSpace(form.Items[0].ProductName))
            form.Items.Clear();

        form.Items.AddRange(result.Items);
    }

    private async Task SaveAsync()
    {
        message = null;
        success = false;

        if (form.Items.Any(x => string.IsNullOrWhiteSpace(x.ProductName) || x.Quantity <= 0))
        {
            message = "Tüm ürün kalemlerinde ürün adı ve sıfırdan büyük miktar bulunmalıdır.";
            return;
        }

        saving = true;
        var request = new CreateQuoteModel
        {
            Type = form.Type,
            Title = form.Title,
            Description = form.Description,
            Submit = form.Submit
        };
        request.Items.AddRange(form.Items);

        var result = await QuoteApi.CreateAsync(request);
        saving = false;
        success = result.Success;
        message = result.Message;

        if (result.Success)
        {
            form.Title = string.Empty;
            form.Description = null;
            form.Items.Clear();
            importMessage = null;
            catalogMessage = null;
            schoolSetMessage = null;
            selectedSetId = Guid.Empty;
            AddItem();
        }
    }

    private sealed class QuoteFormModel
    {
        [Range(1, 2)] public int Type { get; set; } = 1;
        [Required, StringLength(200, MinimumLength = 3)] public string Title { get; set; } = string.Empty;
        [StringLength(2000)] public string? Description { get; set; }
        public bool Submit { get; set; } = true;
        public List<CreateQuoteItemModel> Items { get; } = [];
    }
}
