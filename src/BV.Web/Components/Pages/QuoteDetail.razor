@page "/tekliflerim/{Id:guid}"
@rendermode InteractiveServer
@using BV.Web.Services
@inject QuoteApiClient Quotes
@inject IJSRuntime JS

<PageTitle>Teklif Detayı</PageTitle>

@if (quote is null)
{
    <div class="panel">Teklif yükleniyor veya bulunamadı.</div>
}
else
{
    <div class="page-heading">
        <div><span class="eyebrow">Teklif Detayı</span><h1>@quote.Title</h1><p>@quote.Description</p></div>
        <div class="form-row">
            @if (response is not null)
            {
                <button class="button primary" @onclick="DownloadPdfAsync" disabled="@downloading">@(downloading ? "PDF hazırlanıyor..." : "PDF İndir")</button>
            }
            <a class="button ghost" href="/tekliflerim">Listeye Dön</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(downloadError))
    {
        <div class="status-message error">@downloadError</div>
    }

    <div class="metric-grid"><article><span>Tür</span><strong>@(quote.Type == 1 ? "Okul" : "Ofis")</strong></article><article><span>Durum</span><strong>@Status(quote.Status)</strong></article><article><span>Kalem</span><strong>@quote.Items.Count</strong></article><article><span>Tarih</span><strong>@quote.CreatedAtUtc.ToLocalTime().ToString("dd.MM")</strong></article></div>
    <div class="panel table-wrap"><h2>Talep Kalemleri</h2><table><thead><tr><th>Ürün</th><th>Miktar</th><th>Birim</th><th>Açıklama</th></tr></thead><tbody>@foreach (var item in quote.Items){<tr><td>@item.ProductName</td><td>@item.Quantity</td><td>@item.Unit</td><td>@item.Notes</td></tr>}</tbody></table></div>

    @if (response is not null)
    {
        <div class="panel table-wrap"><div class="panel-heading"><h2>Fiyat Teklifi</h2><strong>Geçerlilik: @response.ValidUntilUtc.ToLocalTime().ToString("dd.MM.yyyy")</strong></div><table><thead><tr><th>Ürün</th><th>Miktar</th><th>Birim Fiyat</th><th>KDV</th><th>Toplam</th></tr></thead><tbody>@foreach (var item in response.Items){<tr><td>@item.ProductName</td><td>@item.Quantity @item.Unit</td><td>@item.UnitPrice.ToString("N2") ₺</td><td>%@item.VatRate</td><td>@item.LineTotal.ToString("N2") ₺</td></tr>}</tbody></table><div class="page-heading"><p>@response.Notes</p><h2>Genel Toplam: @response.Items.Sum(x => x.LineTotal).ToString("N2") ₺</h2></div></div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }
    private QuoteDetailModel? quote;
    private QuoteResponseModel? response;
    private bool downloading;
    private string? downloadError;

    protected override async Task OnParametersSetAsync()
    {
        quote = await Quotes.GetAsync(Id);
        if (quote is not null)
            response = await Quotes.GetResponseAsync(Id);
    }

    private async Task DownloadPdfAsync()
    {
        downloading = true;
        downloadError = null;
        try
        {
            var result = await Quotes.DownloadPdfAsync(Id);
            if (!result.Success || result.Content is null)
            {
                downloadError = result.Error ?? "PDF indirilemedi.";
                return;
            }

            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                result.FileName ?? $"BV-Teklif-{Id:N}.pdf",
                "application/pdf",
                Convert.ToBase64String(result.Content));
        }
        finally
        {
            downloading = false;
        }
    }

    private static string Status(int status) => status switch { 0 => "Taslak", 1 => "Gönderildi", 2 => "İnceleniyor", 3 => "Cevaplandı", 4 => "İptal", _ => "Bilinmiyor" };
}
