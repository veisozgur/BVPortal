@page "/admin/customers"
@rendermode InteractiveServer
@using BV.Web.Services
@inject AdminApiClient Admin
@inject NavigationManager Navigation

<PageTitle>Müşteriler - Yönetim</PageTitle>

<section class="page-heading">
    <div><span class="eyebrow">Yönetim / Müşteriler</span><h1>Müşteri yönetimi</h1><p>Kayıtlı müşterileri ve teklif yoğunluklarını görüntüleyin.</p></div>
</section>

<div class="panel">
    <div class="form-row"><input class="form-control" @bind="search" placeholder="Ad, firma, telefon veya e-posta ara" /><button class="button primary" @onclick="LoadAsync">Ara</button></div>
</div>

@if (loading)
{
    <div class="panel">Müşteriler yükleniyor...</div>
}
else if (items.Count == 0)
{
    <div class="panel empty-state"><h2>Müşteri bulunamadı</h2></div>
}
else
{
    <div class="panel table-wrap"><table><thead><tr><th>Müşteri</th><th>Firma</th><th>İletişim</th><th>Konum</th><th>Teklif</th><th></th></tr></thead><tbody>
    @foreach (var item in items)
    {
        <tr><td><strong>@item.FullName</strong></td><td>@item.OrganizationName</td><td>@item.PhoneNumber<br />@item.Email</td><td>@item.City / @item.District</td><td>@item.QuoteCount</td><td><button class="button ghost" @onclick="() => OpenCustomer(item.Id)">Detay</button></td></tr>
    }
    </tbody></table></div>
}

@code {
    private IReadOnlyList<AdminCustomerListItemModel> items = [];
    private bool loading = true;
    private string? search;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            items = await Admin.ListCustomersAsync(search);
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenCustomer(Guid id) => Navigation.NavigateTo($"/admin/customers/{id}");
}
