@page "/admin/quotes/{Id:guid}"
@rendermode InteractiveServer
@using BV.Web.Services
@inject AdminApiClient Admin

<PageTitle>Teklif Detayı - Yönetim</PageTitle>

@if (loading)
{
    <div class="panel">Teklif detayı yükleniyor...</div>
}
else if (detail is null)
{
    <div class="panel"><h2>Teklif bulunamadı</h2><p>Teklif mevcut değil veya yönetici yetkiniz bulunmuyor.</p></div>
}
else
{
    <section class="page-heading">
        <div><span class="eyebrow">Yönetim / Teklif</span><h1>@detail.Title</h1><p>@detail.CustomerName · @detail.CustomerPhone · @detail.CustomerEmail</p></div>
        <a class="button ghost" href="/admin/quotes">Listeye Dön</a>
    </section>

    <section class="dashboard-grid">
        <article class="panel">
            <div class="panel-heading"><div><h2>Talep kalemleri</h2><p>@detail.Description</p></div></div>
            <div class="table-wrap"><table><thead><tr><th>Ürün</th><th>Miktar</th><th>Birim</th><th>Not</th></tr></thead><tbody>
            @foreach (var item in detail.Items)
            {
                <tr><td><strong>@item.ProductName</strong></td><td>@item.Quantity</td><td>@item.Unit</td><td>@item.Notes</td></tr>
            }
            </tbody></table></div>
        </article>

        <article class="panel">
            <div class="panel-heading"><div><h2>Operasyon</h2><p>Teklif durumunu yönetin.</p></div></div>
            <label>Durum</label>
            <select class="form-control" @bind="selectedStatus">
                <option value="1">Gönderildi</option>
                <option value="2">İnceleniyor</option>
                <option value="4">İptal</option>
            </select>
            <button class="button primary" @onclick="SaveStatusAsync" disabled="@saving">@(saving ? "Kaydediliyor..." : "Durumu Güncelle")</button>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="status-message @(success ? "success" : "error")">@message</div>
            }
        </article>
    </section>

    <section class="dashboard-grid">
        <article class="panel">
            <div class="panel-heading"><div><h2>Operasyon notları</h2><p>Yalnızca yönetim ekibinin görebileceği iç notlar.</p></div></div>
            <textarea class="form-control" rows="3" @bind="newNote" placeholder="Notunuzu yazın..."></textarea>
            <button class="button primary" @onclick="AddNoteAsync" disabled="@noteSaving">@(noteSaving ? "Ekleniyor..." : "Not Ekle")</button>
            @foreach (var note in notes)
            {
                <div class="status-message"><strong>@note.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong><br />@note.Note</div>
            }
        </article>

        @if (detail.Response is null)
        {
            <article class="panel">
                <div class="panel-heading"><div><h2>Fiyat teklifi hazırla</h2><p>Talep kalemlerini fiyatlandırıp müşteriye gönderin.</p></div></div>
                <label>Mesaj</label>
                <textarea class="form-control" rows="3" @bind="answer.Message"></textarea>
                <label>Geçerlilik tarihi</label>
                <InputDate class="form-control" @bind-Value="answer.ValidUntilUtc" />

                @foreach (var item in answer.Items)
                {
                    <div class="quote-item-row">
                        <input class="form-control" @bind="item.ProductName" placeholder="Ürün" />
                        <input class="form-control" type="number" step="0.01" @bind="item.Quantity" />
                        <input class="form-control" @bind="item.Unit" placeholder="Birim" />
                        <input class="form-control" type="number" step="0.01" @bind="item.UnitPrice" placeholder="Birim fiyat" />
                        <input class="form-control" type="number" step="0.01" @bind="item.VatRate" placeholder="KDV" />
                    </div>
                }

                <div class="auth-links">
                    <label><InputCheckbox @bind-Value="answer.NotifyBySms" /> SMS gönder</label>
                    <label><InputCheckbox @bind-Value="answer.NotifyByEmail" /> E-posta gönder</label>
                </div>
                <strong>Genel toplam: @AnswerTotal().ToString("N2") ₺</strong>
                <button class="button primary" @onclick="SendAnswerAsync" disabled="@answerSaving">@(answerSaving ? "Gönderiliyor..." : "Teklifi Gönder")</button>
            </article>
        }
    </section>

    @if (detail.Response is not null)
    {
        <article class="panel">
            <div class="panel-heading"><div><h2>Gönderilen fiyat teklifi</h2><p>@detail.Response.Message</p></div><strong>@detail.Response.TotalAmount.ToString("N2") ₺</strong></div>
            <div class="table-wrap"><table><thead><tr><th>Ürün</th><th>Miktar</th><th>Birim Fiyat</th><th>KDV</th><th>Toplam</th></tr></thead><tbody>
            @foreach (var item in detail.Response.Items)
            {
                <tr><td>@item.ProductName</td><td>@item.Quantity @item.Unit</td><td>@item.UnitPrice.ToString("N2") ₺</td><td>%@item.VatRate</td><td>@item.LineTotal.ToString("N2") ₺</td></tr>
            }
            </tbody></table></div>
        </article>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }
    private AdminQuoteDetailModel? detail;
    private IReadOnlyList<AdminOperationNoteModel> notes = [];
    private readonly AdminAnswerQuoteModel answer = new();
    private bool loading = true;
    private bool saving;
    private bool noteSaving;
    private bool answerSaving;
    private bool success;
    private string? message;
    private string newNote = string.Empty;
    private int selectedStatus = 2;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        try
        {
            detail = await Admin.GetQuoteDetailAsync(Id);
            notes = await Admin.ListOperationNotesAsync(Id);
            if (detail is not null)
            {
                selectedStatus = detail.Status;
                if (answer.Items.Count == 0)
                {
                    foreach (var item in detail.Items)
                    {
                        answer.Items.Add(new AdminAnswerQuoteItemModel
                        {
                            ProductName = item.ProductName,
                            Quantity = item.Quantity,
                            Unit = item.Unit
                        });
                    }
                }
            }
        }
        finally { loading = false; }
    }

    private async Task SaveStatusAsync()
    {
        saving = true;
        var result = await Admin.ChangeQuoteStatusAsync(Id, selectedStatus);
        saving = false;
        success = result.Success;
        message = result.Message;
        if (result.Success && detail is not null)
            detail = detail with { Status = selectedStatus };
    }

    private async Task AddNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(newNote))
            return;

        noteSaving = true;
        var result = await Admin.AddOperationNoteAsync(Id, newNote);
        noteSaving = false;
        success = result.Success;
        message = result.Message;
        if (result.Success)
        {
            newNote = string.Empty;
            notes = await Admin.ListOperationNotesAsync(Id);
        }
    }

    private async Task SendAnswerAsync()
    {
        answerSaving = true;
        var result = await Admin.AnswerQuoteAsync(Id, answer);
        answerSaving = false;
        success = result.Success;
        message = result.Message;
        if (result.Success)
            detail = await Admin.GetQuoteDetailAsync(Id);
    }

    private decimal AnswerTotal() => answer.Items.Sum(x => x.Quantity * x.UnitPrice * (1 + x.VatRate / 100m));
}
